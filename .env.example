# ==============================================================================
# ShiftSync Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# Example: cp .env.example .env

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Credentials used when starting PostgreSQL locally or via Docker Compose.
POSTGRES_USER=shiftsync
POSTGRES_PASSWORD=password123
POSTGRES_DB=shiftsync
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Backend Service (NestJS - apps/server)
# ------------------------------------------------------------------------------
# Database connection string used by NestJS (DatabaseModule) and Drizzle Kit.
# For local host execution:
DATABASE_URL=postgresql://shiftsync:password123@localhost:5432/shiftsync?sslmode=disable
# For Docker Compose execution (service container networking):
# DATABASE_URL=postgresql://shiftsync:password123@db:5432/shiftsync?sslmode=disable

# Secret key used for signing and validating JWT tokens in AuthModule.
JWT_SECRET=supersecretjwtkeyforlocaldevelopment1234567890

# Port on which the NestJS backend listens (default: 3001).
PORT=3001

# Application environment (development | test | production).
# In 'test' mode, db:seed runs lightweight base seeding.
NODE_ENV=development

# ------------------------------------------------------------------------------
# Frontend Application (React Vite SPA - apps/client)
# ------------------------------------------------------------------------------
# API URL consumed by the client Axios instance and WebSocket notifications.
VITE_API_URL=http://localhost:3001/api
